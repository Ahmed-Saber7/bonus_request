<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contract_dynamic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="d" t-value="doc._re_contract_print_data()"/>
                <t t-call="web.basic_layout">
                    <div class="page ct-page" dir="rtl">
                        <style>
                            .ct-page { font-family: "DejaVu Sans", Arial, Tahoma, sans-serif; color: #000; font-size: 12px; border: 1.2px solid #000; padding: 5mm; }
                            .ct-top { width: 100%; border-collapse: collapse; border-bottom: 1.2mm solid #c9a227; padding-bottom: 2mm; }
                            .ct-top td { font-size: 10px; font-weight: bold; vertical-align: top; padding: 0.5mm 0; line-height: 1.5; }
                            .ct-addr { text-align: right; }
                            .ct-contact { text-align: left; direction: ltr; }
                            .ct-num { direction: ltr; unicode-bidi: embed; }
                            .ct-brand { width: 100%; border-collapse: collapse; margin-top: 3mm; }
                            .ct-logo { max-height: 20mm; max-width: 42mm; object-fit: contain; }
                            .ct-company { font-size: 24px; font-weight: bold; text-align: center; }
                            .ct-title-box { background: #000; color: #fff; text-align: center; font-size: 16px; font-weight: bold; padding: 2mm 10mm; display: inline-block; }
                            .ct-title-wrap { text-align: center; margin: 3mm 0; }
                            .ct-line { margin: 2mm 0; font-size: 12px; }
                            .ct-lbl { font-weight: bold; }
                            .ct-type { background: #efefef; border: 1px solid #000; text-align: center; font-weight: bold; padding: 2mm; margin: 3mm 0; }
                            .ct-terms { font-size: 11px; line-height: 1.7; text-align: justify; }
                            .ct-terms ol { direction: rtl; padding-right: 8mm; margin: 2mm 0; }
                            .ct-terms li { padding-right: 2mm; margin-bottom: 1.6mm; }
                            .ct-terms p { margin: 1mm 0 2mm 0; }
                            .ct-sign { width: 100%; margin-top: 10mm; border-collapse: collapse; }
                            .ct-sign td { text-align: center; font-weight: bold; font-size: 12px; padding-top: 2mm; }
                            .ct-pagenum { text-align: center; font-size: 9px; color: #333; margin-top: 6mm; }
                        </style>

                        <!-- ===== Header: dynamic from Company Settings ===== -->
                        <table class="ct-top">
                            <tr>
                                <td class="ct-addr">
                                    <div t-if="d['company_address']" t-esc="d['company_address']"/>
                                </td>
                                <td class="ct-contact">
                                    <div t-if="d['company_phone']"><span style="direction: rtl;">هاتف :</span> <span class="ct-num" t-esc="d['company_phone']"/></div>
                                    <div t-if="d['company_email']" class="ct-num" t-esc="d['company_email']"/>
                                    <div t-if="d['company_website']" class="ct-num" t-esc="d['company_website']"/>
                                </td>
                            </tr>
                        </table>

                        <div style="text-align: center; margin-top: 3mm;">
                            <img t-if="d.get('logo_src')" class="ct-logo" t-att-src="d['logo_src']" alt="logo"/>
                        </div>
                        <div class="ct-company"><t t-esc="d['company_name']"/></div>

                        <div class="ct-title-wrap"><span class="ct-title-box">عقد إيجار</span></div>

                        <div class="ct-line"><span class="ct-lbl">رقم العقد :</span> <t t-esc="d['contract_no']"/></div>

                        <div class="ct-line"><span class="ct-lbl">حرر هذا العقد بين كل من :-</span></div>
                        <div class="ct-line"><span class="ct-lbl">أولاً : السيد /</span> <t t-esc="d['landlord']"/> <span style="float: left;" class="ct-lbl">الطرف الأول ( مؤجر )</span></div>
                        <div class="ct-line"><span class="ct-lbl">ثانياً : السيد /</span> <t t-esc="d['tenant']"/> <span style="float: left;" class="ct-lbl">الطرف الثاني ( مستأجر )</span></div>
                        <div class="ct-line">
                            <span class="ct-lbl">الجنسية :</span> <t t-esc="d['tenant_nationality']"/>
                            &#160;&#160;<span class="ct-lbl">الرقم المدني :</span> <t t-esc="d['tenant_civil']"/>
                            &#160;&#160;<span class="ct-lbl">هاتف :</span> <t t-esc="d['tenant_phone']"/>
                        </div>
                        <div class="ct-line"><span class="ct-lbl">الوظيفة :</span> <t t-esc="d['tenant_job']"/></div>
                        <div class="ct-line"><span class="ct-lbl">استأجر الطرف الثاني من الطرف الأول :</span> <t t-esc="d['unit_desc']"/></div>
                        <div class="ct-line">
                            <span class="ct-lbl">مقدار الأجرة :</span> <t t-esc="d['rent']"/> (<t t-esc="d['rent_words']"/>) تدفع مقدماً بداية كل شهر.
                        </div>
                        <div class="ct-line">
                            <span class="ct-lbl">مدة العقد :</span> من <t t-esc="d['date_start']"/> إلى <t t-esc="d['date_end']"/>
                        </div>

                        <div class="ct-type" t-if="d['type_name']">نوع العقد (الشروط) : <t t-esc="d['type_name']"/></div>

                        <!-- ===== Terms: dynamic from Contract Type ===== -->
                        <div class="ct-terms">
                            <div t-field="doc.terms"/>
                        </div>

                        <table class="ct-sign">
                            <tr>
                                <td>الطرف الأول / المؤجر</td>
                                <td>الطرف الثاني / المستأجر</td>
                            </tr>
                            <tr>
                                <td>........................................</td>
                                <td>........................................</td>
                            </tr>
                            <tr>
                                <td><t t-esc="d['landlord']"/></td>
                                <td><t t-esc="d['tenant']"/></td>
                            </tr>
                        </table>

                        <div class="footer ct-pagenum">
                            صفحة <span class="page"/> من <span class="topage"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
